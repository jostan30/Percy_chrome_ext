{
  "manifest_version": 3,
  "name": "Percy Local Manager",
  "version": "1.0.0",
  "description": "Capture browser state (DOM, URL, viewport) and send it to the local Percy Local Manager backend.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Percy Local Manager"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:4321/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}